# Copy to .env and fill in. Never commit .env.

# Gmail address that sends the cold emails (should match the one on your resume).
GMAIL_ADDRESS=
# 16-character app password: https://myaccount.google.com/apppasswords
# (needs 2-Step Verification turned on for the account)
GMAIL_APP_PASSWORD=

# Apollo.io API key: Apollo > Settings > Integrations > API. Leave empty to skip Apollo.
APOLLO_API_KEY=

# Notion internal integration secret (starts with ntn_): https://www.notion.so/profile/integrations
# Then open the "Job Hunt" database > ••• > Connections > add your integration.
NOTION_TOKEN=
